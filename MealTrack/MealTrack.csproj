<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MealTrack</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- SQL scripts used by the init-db command -->
    <None Update="Database\*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
