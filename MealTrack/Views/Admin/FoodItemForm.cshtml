@model FoodFormVm
@{
    var food = Model.Food;
    var form = Model.Form;
    ViewData["Title"] = food is null ? "Add Food Item" : "Edit Food Item";
    ViewData["PageTitle"] = food is null ? "Add food item" : "Edit food item";
}
@section PageSub {<a href="/admin/food-items" class="text-decoration-none">← Back to food items</a>}
<div class="row g-4">
  <div class="col-lg-7">
    <div class="card">
      <div class="card-header"><h2>@Ui.Icon("utensils") @(food?.FoodName ?? "New menu item")</h2>@if (food is not null) { @Ui.StatusBadge(food.Status) }</div>
      <div class="card-body">
        <form method="post" asp-antiforgery="true" novalidate>
          <div class="mb-3">
            <label class="form-label" for="food_name">Food name <span class="text-green">*</span></label>
            <input class="form-control" id="food_name" name="food_name" value="@form.FoodName" required maxlength="100" placeholder="e.g. Masala Dosa" autofocus>
          </div>
          <div class="mb-3">
            <label class="form-label" for="description">Description</label>
            <textarea class="form-control" id="description" name="description" rows="2" maxlength="255" placeholder="e.g. Dosa with potato masala, sambar and chutney">@form.Description</textarea>
            <div class="form-text">Shown to customers on the schedule (max 255 characters).</div>
          </div>
          <div class="row g-3 mb-3">
            <div class="col-sm-6">
              <label class="form-label" for="unit">Unit (one portion)</label>
              <select class="form-select" id="unit" name="unit">
                @foreach (var u in Model.Units)
                {
                  <option value="@u" selected="@(form.Unit == u)">@Fmt.Title(u)</option>
                }
              </select>
            </div>
            <div class="col-sm-6">
              <label class="form-label" for="price">Price per portion <span class="text-muted fw-normal">(optional)</span></label>
              <div class="input-group">
                <span class="input-group-text">₹</span>
                <input class="form-control" id="price" name="price" type="number" min="0" max="99999.99" step="0.01" value="@form.Price" placeholder="0.00">
              </div>
              <div class="form-text">Customers can see it but can't change it. Used for cost estimates.</div>
            </div>
          </div>
          <div class="mb-4">
            <span class="form-label d-block">Status</span>
            <div class="form-check form-check-inline">
              <input class="form-check-input" type="radio" name="status" id="st_active" value="active" checked="@(form.Status != "inactive")">
              <label class="form-check-label" for="st_active">Active, available for schedules</label>
            </div>
            <div class="form-check form-check-inline">
              <input class="form-check-input" type="radio" name="status" id="st_inactive" value="inactive" checked="@(form.Status == "inactive")">
              <label class="form-check-label" for="st_inactive">Inactive</label>
            </div>
          </div>
          <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-primary" type="submit" name="next_action" value="save">@Ui.Icon("save") @(food is null ? "Add food item" : "Save changes")</button>
            @if (food is null)
            {
            <button class="btn btn-outline-primary" type="submit" name="next_action" value="add_another">@Ui.Icon("plus") Save &amp; add another</button>
            }
            <a class="btn btn-outline-secondary" href="/admin/food-items">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
  <div class="col-lg-5">
    @if (food is not null)
    {
    <div class="card">
      <div class="card-header"><h2>@Ui.Icon("calendar-days") Upcoming schedules</h2></div>
      @if (Model.Usage.Count > 0)
      {
      <ul class="list-group list-group-flush">
        @foreach (var u in Model.Usage)
        {
          <li class="list-group-item d-flex justify-content-between"><span>@Fmt.Date(u.ScheduleDate, "ddd, dd MMM")</span><span class="text-muted">@u.MealName</span></li>
        }
      </ul>
      <div class="card-body small text-muted pt-2">Changes to the name or description appear on these meals immediately.</div>
      }
      else
      {
      <div class="card-body small text-muted">This item isn't scheduled for any upcoming meal.</div>
      }
    </div>
    }
    else
    {
    <div class="card card-muted">
      <div class="card-body">
        <h2 class="h6">@Ui.Icon("lightbulb", "me-1") Tips</h2>
        <ul class="small text-muted mb-0 ps-3">
          <li>Use one item per dish customers count separately (e.g. "Idly" and "Vada").</li>
          <li>The unit tells customers what one portion means: 1 plate, 1 piece and so on.</li>
          <li>New items appear when the admin builds daily and weekly schedules.</li>
        </ul>
      </div>
    </div>
    }
  </div>
</div>
