@model CountsVm
@{
    ViewData["Title"] = "Food Counts";
    ViewData["PageTitle"] = "View Food Counts";
    var dates = Model.Totals.Select(t => t.ScheduleDate).Distinct().Order().ToList();
    var meals = Model.MealTypes.Where(m => Model.Meal is null || m.Id == Model.Meal).ToList();
}
@section PageSub {@(Model.Start == Model.End ? Fmt.Date(Model.Start, "dddd, dd MMM yyyy") : $"{Fmt.Date(Model.Start, "dd MMM")} – {Fmt.Date(Model.End, "dd MMM yyyy")}")}
<form class="card card-body mb-4" method="get">
  <input type="hidden" name="tab" value="@Model.Tab">
  <div class="row g-3 align-items-end">
    <div class="col-6 col-md-3 col-xl-2">
      <label class="form-label" for="start">From</label>
      <input class="form-control" type="date" id="start" name="start" value="@Fmt.IsoDate(Model.Start)">
    </div>
    <div class="col-6 col-md-3 col-xl-2">
      <label class="form-label" for="end">To</label>
      <input class="form-control" type="date" id="end" name="end" value="@Fmt.IsoDate(Model.End)">
    </div>
    <div class="col-6 col-md-3 col-xl-2">
      <label class="form-label" for="meal">Meal</label>
      <select class="form-select" id="meal" name="meal">
        <option value="">All meals</option>
        @foreach (var m in Model.MealTypes) {<option value="@m.Id" selected="@(Model.Meal == m.Id)">@m.MealName</option>}
      </select>
    </div>
    <div class="col-6 col-md-3 col-xl-3">
      <label class="form-label" for="customer">Customer</label>
      <select class="form-select" id="customer" name="customer">
        <option value="">All customers</option>
        @foreach (var c in Model.Customers) {<option value="@c.Id" selected="@(Model.Customer == c.Id)">@(c.Name + (c.RoomNo is null ? "" : $" · {c.RoomNo}"))</option>}
      </select>
    </div>
    <div class="col-xl-3 d-flex gap-2">
      <button class="btn btn-primary flex-grow-1" type="submit">@Ui.Icon("filter") Apply</button>
      <a class="btn btn-outline-secondary" href="/admin/counts">Today</a>
    </div>
  </div>
</form>

<div class="card table-card mb-4">
  <div class="card-header"><h2>@Ui.Icon("calculator") Date- and meal-wise totals</h2><span class="small text-muted">valid submissions of active customers</span></div>
  @if (dates.Count > 0)
  {
  <div class="table-responsive">
    <table class="table pivot mb-0">
      <thead><tr><th>Date</th>@foreach (var m in meals) {<th class="text-end">@m.MealName</th>}<th class="text-end">Total</th></tr></thead>
      <tbody>
      @foreach (var d in dates)
      {
        var dayRows = Model.Totals.Where(t => t.ScheduleDate == d).ToList();
        <tr>
          <td>@Fmt.Date(d, "ddd, dd MMM")</td>
          @foreach (var m in meals)
          {
            var t = dayRows.FirstOrDefault(r => r.MealTypeId == m.Id);
            <td class="text-end">@if (t is null) {<span class="text-muted">—</span>} else {<span class="fw-semibold">@t.TotalQty</span> <span class="small text-muted">(@t.Submitters)</span>}</td>
          }
          <td class="text-end fw-bold">@dayRows.Sum(r => r.TotalQty)</td>
        </tr>
      }
      </tbody>
      <tfoot>
        <tr><td>Total</td>@foreach (var m in meals) {<td class="text-end">@Model.Totals.Where(t => t.MealTypeId == m.Id).Sum(t => t.TotalQty)</td>}<td class="text-end text-green">@Model.Totals.Sum(t => t.TotalQty)</td></tr>
      </tfoot>
    </table>
  </div>
  <div class="card-body small text-muted pt-2">Numbers in brackets are how many customers submitted.</div>
  }
  else
  {
    @Ui.EmptyState("calendar-x", "No published meals in this period")
  }
</div>

<div class="card table-card">
  <div class="card-header">
    <ul class="nav nav-tabs card-header-tabs">
      @foreach (var (key, label) in new[] { ("all", "All"), ("submitted", "Submitted"), ("pending", "Pending") })
      {
        <li class="nav-item"><a class="nav-link @(Model.Tab == key ? "active" : "")" href="/admin/counts?@Model.Query(new { tab = key, page = 1 })">@label <span class="badge bg-grey-soft text-black ms-1">@Model.TabCounts[key]</span></a></li>
      }
    </ul>
  </div>
  @if (Model.Rows.Count > 0)
  {
  <div class="table-responsive">
    <table class="table table-hover table-sm">
      <thead><tr><th>Date</th><th>Meal</th><th>Customer</th><th>Room</th><th class="text-center">Qty</th><th>Status</th><th class="d-none d-md-table-cell">Updated</th></tr></thead>
      <tbody>
      @foreach (var r in Model.Rows)
      {
        <tr>
          <td class="text-nowrap">@Fmt.Date(r.ScheduleDate, "ddd, dd MMM")</td>
          <td>@Ui.MealChip(r.MealName) <span class="small text-muted">@r.FoodName</span></td>
          <td><a class="text-reset" href="/admin/customers/@r.CustomerId">@r.CustomerName</a></td>
          <td>@(r.RoomNo ?? "—")</td>
          <td class="text-center fw-bold">@(r.SubmissionStatus is "submitted" or "locked" ? r.Quantity.ToString() : "–")</td>
          <td>@Ui.StatusBadge(r.Status)</td>
          <td class="d-none d-md-table-cell small text-muted">@(r.UpdatedAt is null ? "—" : Fmt.Dt(r.UpdatedAt, "dd MMM, hh:mm tt"))</td>
        </tr>
      }
      </tbody>
    </table>
  </div>
  }
  else
  {
    @Ui.EmptyState("clipboard-list", Model.Tab == "pending" ? "Everyone has submitted" : "No counts found")
  }
</div>
@if (Model.Pages > 1)
{
<nav class="mt-3"><ul class="pagination pagination-sm justify-content-end mb-0">
  <li class="page-item @(Model.Page <= 1 ? "disabled" : "")"><a class="page-link" href="/admin/counts?@Model.Query(new { page = Model.Page - 1 })">Previous</a></li>
  @for (var p = 1; p <= Model.Pages; p++)
  {
    if (p == 1 || p == Model.Pages || Math.Abs(p - Model.Page) <= 2)
    {
      <li class="page-item @(p == Model.Page ? "active" : "")"><a class="page-link" href="/admin/counts?@Model.Query(new { page = p })">@p</a></li>
    }
    else if (Math.Abs(p - Model.Page) == 3)
    {
      <li class="page-item disabled"><span class="page-link">…</span></li>
    }
  }
  <li class="page-item @(Model.Page >= Model.Pages ? "disabled" : "")"><a class="page-link" href="/admin/counts?@Model.Query(new { page = Model.Page + 1 })">Next</a></li>
</ul></nav>
}
