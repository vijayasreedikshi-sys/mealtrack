@model ScheduleGridVm
@{
    ViewData["Title"] = "Week Builder";
    var ws = Fmt.IsoDate(Model.WeekStart);
}
@section PageSub {<a href="/admin/schedules?week=@ws" class="text-decoration-none">← Back to schedules</a> · Week of @Fmt.Date(Model.WeekStart, "dd MMM") – @Fmt.Date(Model.WeekEnd, "dd MMM yyyy")}
<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
  <div class="btn-group">
    <a class="btn btn-outline-secondary btn-sm" href="/admin/schedules/builder?week=@Fmt.IsoDate(Model.WeekStart.AddDays(-7))">@Ui.Icon("chevron-left") Previous</a>
    <a class="btn btn-outline-secondary btn-sm" href="/admin/schedules/builder?week=@Fmt.IsoDate(Model.WeekStart.AddDays(7))">Next @Ui.Icon("chevron-right")</a>
  </div>
  <div class="small text-muted">Pick one food per meal. Leave a cell on “—” to keep it empty or unchanged. Cutoffs use the default times.</div>
</div>

<form method="post" asp-antiforgery="true">
  <input type="hidden" name="week" value="@ws">
  <div class="card table-card">
    <div class="table-responsive">
      <table class="table week-grid mb-0">
        <thead><tr><th>Date</th>@foreach (var m in Model.MealTypes) {<th>@Ui.MealChip(m.MealName)</th>}</tr></thead>
        <tbody>
        @for (var i = 0; i < 7; i++)
        {
          var d = Model.WeekStart.AddDays(i);
          <tr>
            <td class="day-cell"><div class="fw-semibold">@Fmt.Date(d, "dddd")</div><div class="small text-muted">@Fmt.Date(d, "dd MMM")</div></td>
            @foreach (var m in Model.MealTypes)
            {
              var c = Model.Cell(d, m.Id);
              <td>
                <select class="form-select form-select-sm builder-select" name="@($"food_{d:yyyyMMdd}_{m.Id}")" aria-label="@m.MealName on @Fmt.Date(d, "dddd")">
                  <option value="">—</option>
                  @foreach (var f in Model.Foods.Where(f => f.Status == "active" || f.Id == c?.FoodItemId))
                  {
                    <option value="@f.Id" selected="@(c?.FoodItemId == f.Id)">@(f.FoodName + (f.Status == "inactive" ? " (inactive)" : ""))</option>
                  }
                </select>
                @if (c is not null)
                {
                  <div class="small mt-1">@Ui.StatusBadge(c.IsPublished ? "published" : "draft") @if (c.Submitters > 0) {<span class="text-muted">@c.Submitters counts</span>}</div>
                }
              </td>
            }
          </tr>
        }
        </tbody>
      </table>
    </div>
    <div class="submit-bar">
      <span class="small text-muted">Saving a changed food on a published meal notifies customers who already submitted.</span>
      <div class="ms-auto d-flex gap-2">
        <button class="btn btn-outline-primary" type="submit" name="save_mode" value="draft">@Ui.Icon("save") Save as draft</button>
        <button class="btn btn-primary" type="submit" name="save_mode" value="publish">@Ui.Icon("send") Save &amp; publish week</button>
      </div>
    </div>
  </div>
</form>
