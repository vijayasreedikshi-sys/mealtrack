@model UserFormVm
@{
    var isNew = Model.User is null;
    var sellers = Model.Kind == "sellers";
    ViewData["Title"] = (isNew ? "Add " : "Edit ") + Model.Label;
    ViewData["PageTitle"] = isNew ? $"Add {Model.Label.ToLowerInvariant()}" : $"Edit {Model.User!.Name}";
}
@section PageSub {<a href="/admin/@Model.Kind" class="text-decoration-none">← Back to @Model.Kind</a>}
<div class="row g-4">
  <div class="col-lg-7">
    <div class="card">
      <div class="card-header"><h2>@Ui.Icon(sellers ? "chef-hat" : "user-round") @Model.Label details</h2></div>
      <div class="card-body">
        <form method="post" asp-antiforgery="true" novalidate>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label" for="name">Full name</label>
              <input class="form-control" id="name" name="name" value="@Model.Name" required maxlength="100" autofocus>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="email">Email (login)</label>
              <input class="form-control" type="email" id="email" name="email" value="@Model.Email" required maxlength="150">
            </div>
            <div class="col-md-6">
              <label class="form-label" for="phone">Phone @if (sellers) {<span class="text-muted fw-normal">(optional)</span>}</label>
              <input class="form-control" id="phone" name="phone" value="@Model.Phone" maxlength="15">
            </div>
            @if (!sellers)
            {
            <div class="col-md-6">
              <label class="form-label" for="room_no">Room no. <span class="text-muted fw-normal">(optional)</span></label>
              <input class="form-control" id="room_no" name="room_no" value="@Model.RoomNo" maxlength="20">
            </div>
            }
            @if (isNew)
            {
            <div class="col-md-6">
              <label class="form-label" for="password">Password <span class="text-muted fw-normal">(optional)</span></label>
              <input class="form-control" type="password" id="password" name="password" autocomplete="new-password">
              <div class="form-text">Leave blank to generate a temporary password.</div>
            </div>
            }
            <div class="col-12">
              <span class="form-label d-block">Status</span>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="status" id="st_active" value="active" checked="@(Model.Status != "inactive")">
                <label class="form-check-label" for="st_active">Active</label>
              </div>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="status" id="st_inactive" value="inactive" checked="@(Model.Status == "inactive")">
                <label class="form-check-label" for="st_inactive">Inactive (can't log in)</label>
              </div>
            </div>
          </div>
          <div class="d-flex flex-wrap gap-2 mt-4">
            <button class="btn btn-primary" type="submit">@Ui.Icon("save") @(isNew ? $"Add {Model.Label.ToLowerInvariant()}" : "Save changes")</button>
            <a class="btn btn-outline-secondary" href="/admin/@Model.Kind">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
  @if (!isNew)
  {
  <div class="col-lg-5">
    <div class="card">
      <div class="card-header"><h2>@Ui.Icon("key-round") Reset password</h2></div>
      <div class="card-body">
        <p class="small text-muted">Generates a new temporary password and shows it once, so you can give it to @Model.User!.FirstName.</p>
        <form method="post" action="/admin/@Model.Kind/@Model.User.Id/reset-password" asp-antiforgery="true" data-confirm="Reset the password for @Model.User.Name?">
          <button class="btn btn-dark btn-sm" type="submit">@Ui.Icon("rotate-ccw-key") Reset password</button>
        </form>
      </div>
    </div>
  </div>
  }
</div>
