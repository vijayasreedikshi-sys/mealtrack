@model AttendanceIndexVm
@{
    ViewData["Title"] = "Meal Check-in";
    var isToday = Model.Selected.Date == DateTime.Today;
    var totalNoShowPortions = Model.Rows.Sum(r => r.NoShowPortions);
}
@section PageSub {Applied vs. actually came · @Fmt.Date(Model.Selected, "dddd, dd MMMM yyyy")}
<form class="d-flex gap-2 align-items-center mb-3" method="get">
  <a class="btn btn-outline-secondary btn-sm btn-icon" href="/attendance?date=@Fmt.IsoDate(Model.Selected.AddDays(-1))" aria-label="Previous day">@Ui.Icon("chevron-left")</a>
  <input class="form-control form-control-sm" type="date" name="date" value="@Fmt.IsoDate(Model.Selected)" onchange="this.form.submit()" style="max-width:180px">
  <a class="btn btn-outline-secondary btn-sm btn-icon" href="/attendance?date=@Fmt.IsoDate(Model.Selected.AddDays(1))" aria-label="Next day">@Ui.Icon("chevron-right")</a>
  <a class="btn btn-sm btn-outline-secondary" href="/attendance">Today</a>
</form>

<div class="alert alert-info">
  @Ui.Icon("qr-code")
  <div>Every meal gets its <strong>own QR code each day</strong>. Open <strong>Show QR</strong> on the counter screen. Customers scan it with their phone camera when they collect food.
  Anyone who applied but did not scan is a <strong>no-show</strong>: food was cooked for them and wasted.</div>
</div>

@if (Model.Rows.Count > 0)
{
<div class="row g-3">
  @foreach (var r in Model.Rows)
  {
    <div class="col-md-6 col-xl-4">
      <div class="card h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start mb-2">
            @Ui.MealChip(r.MealName)
            @if (r.Tracked) { <span class="status status-completed">QR in use</span> } else { <span class="status status-pending">No scans yet</span> }
          </div>
          <div class="fw-semibold fs-5 mb-3">@r.FoodName</div>
          <div class="att-grid mb-3">
            <div><div class="small-caps">Applied</div><div class="fs-4 fw-bold">@r.Applied</div><div class="small text-muted">@r.AppliedPortions portions</div></div>
            <div><div class="small-caps">Came</div><div class="fs-4 fw-bold text-green">@r.Came</div><div class="small text-muted">@(r.Tracked ? $"{r.AttendancePct}%" : "—")</div></div>
            <div><div class="small-caps">No-show</div><div class="fs-4 fw-bold">@(r.Tracked ? r.NoShows.ToString() : "—")</div><div class="small text-muted">@(r.Tracked ? $"{r.NoShowPortions} portions" : "not tracked")</div></div>
          </div>
          @if (r.Tracked && r.Applied > 0)
          {
            <div class="progress prep-bar mb-3" title="@r.AttendancePct% came"><div class="progress-bar" style="width:@r.AttendancePct.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div></div>
          }
          <div class="d-flex flex-wrap gap-2">
            @if (isToday)
            {
              <a class="btn btn-primary btn-sm" href="/attendance/@r.ScheduleId">@Ui.Icon("qr-code") Show QR</a>
            }
            <a class="btn btn-outline-secondary btn-sm" href="/attendance/@r.ScheduleId/list">@Ui.Icon("list-checks") List</a>
            @if (r.WalkIns > 0) { <span class="small text-muted align-self-center">+@r.WalkIns @(r.WalkIns == 1 ? "walk-in" : "walk-ins")</span> }
          </div>
        </div>
      </div>
    </div>
  }
</div>
if (totalNoShowPortions > 0)
{
  <p class="small text-muted mt-3 mb-0">@totalNoShowPortions portions were applied for but not collected on this day.</p>
}
}
else
{
  <div class="card">@Ui.EmptyState("calendar-x", "No published meals on this date", Context.CurrentUser()!.Role == Roles.Seller ? "Only meals assigned to you are shown." : null)</div>
}
