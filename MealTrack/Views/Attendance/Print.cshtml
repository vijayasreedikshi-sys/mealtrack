@model AttendancePrintVm
@{
    Layout = null;
    var m = Model.Meal;
}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@m.MealName QR · @Fmt.Date(m.ScheduleDate, "dd MMM yyyy") · MealTrack</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
  <style>
    body { margin: 0; font-family: Inter, system-ui, sans-serif; color: #171717; background: #FFFFFF; }
    .sheet { max-width: 560px; margin: 32px auto; padding: 32px; border: 2px solid #16A34A; border-radius: 16px; text-align: center; }
    .brand { color: #16A34A; font-weight: 800; letter-spacing: .02em; }
    h1 { font-size: 2.2rem; margin: .4rem 0 0; }
    .food { font-size: 1.2rem; font-weight: 600; margin-top: .2rem; }
    .date { color: #737373; margin-top: .2rem; }
    .qr { width: 340px; max-width: 100%; margin: 20px auto 8px; }
    .qr svg { width: 100%; height: auto; display: block; }
    .steps { text-align: left; color: #171717; margin: 16px auto 0; max-width: 400px; }
    .note { color: #737373; font-size: .85rem; margin-top: 16px; }
    .bar { margin: 16px auto; text-align: center; }
    button { background: #16A34A; color: #FFFFFF; border: 0; border-radius: 8px; padding: 10px 18px; font: inherit; font-weight: 600; cursor: pointer; }
    @@media print { .bar { display: none; } .sheet { margin: 0 auto; } }
  </style>
</head>
<body>
  <div class="bar"><button type="button" onclick="window.print()">Print this QR</button></div>
  <div class="sheet">
    <div class="brand">MealTrack · Meal check-in</div>
    <h1>@m.MealName</h1>
    <div class="food">@m.FoodName</div>
    <div class="date">@Fmt.Date(m.ScheduleDate, "dddd, dd MMMM yyyy") only</div>
    <div class="qr">@Html.Raw(Model.Svg)</div>
    <ol class="steps">
      <li>Open your phone camera and scan this code.</li>
      <li>Log in to MealTrack if asked.</li>
      <li>Your meal is marked as eaten. No camera? Type code <strong>@(Model.Code[..3]) @(Model.Code[3..])</strong> in MealTrack → Meal Check-in.</li>
    </ol>
    <div class="note">This QR works only for this meal on this day. Tomorrow there is a new QR.</div>
  </div>
</body>
</html>
