@inject Microsoft.Extensions.Options.IOptions<MealTrack.Data.AppOptions> AppOptions
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Log in";
}
<h2 class="h3 mb-1">Welcome back</h2>
<p class="text-muted mb-4">Log in to manage your meal counts.</p>
<form method="post" asp-antiforgery="true" novalidate>
  <div class="mb-3">
    <label class="form-label" for="email">Email</label>
    <input class="form-control" type="email" id="email" name="email" value="@ViewData["Email"]" required autofocus autocomplete="email">
  </div>
  <div class="mb-2">
    <div class="d-flex justify-content-between">
      <label class="form-label" for="password">Password</label>
      <a class="small text-decoration-none" href="/forgot-password">Forgot password?</a>
    </div>
    <input class="form-control" type="password" id="password" name="password" required autocomplete="current-password">
  </div>
  <button class="btn btn-primary w-100 mt-3 py-2" type="submit">Log in</button>
</form>
<p class="text-center text-muted small mt-4 mb-4">New resident? <a href="/register" class="fw-semibold text-decoration-none">Create an account</a></p>
@if (AppOptions.Value.ShowDemoAccounts)
{
<div class="demo-box">
  <div class="fw-semibold text-black mb-1">Demo accounts</div>
  Admin: <code>admin@mealtrack.local</code> / <code>Admin@123</code><br>
  Seller: <code>seller1@mealtrack.local</code> / <code>Seller@123</code><br>
  Customer: <code>customer1@mealtrack.local</code> / <code>Customer@123</code>
</div>
}
