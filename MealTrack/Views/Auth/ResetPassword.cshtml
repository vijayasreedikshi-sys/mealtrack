@model string
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Reset password";
}
<h2 class="h3 mb-1">Set a new password</h2>
<p class="text-muted mb-4">Choose a new password for your account.</p>
<form method="post" asp-antiforgery="true" novalidate>
  <div class="mb-3">
    <label class="form-label" for="password">New password</label>
    <input class="form-control" type="password" id="password" name="password" required autocomplete="new-password">
    <div class="form-text">At least 8 characters, with letters and numbers.</div>
  </div>
  <div class="mb-3">
    <label class="form-label" for="confirm_password">Confirm new password</label>
    <input class="form-control" type="password" id="confirm_password" name="confirm_password" required autocomplete="new-password">
  </div>
  <button class="btn btn-primary w-100 py-2" type="submit">Update password</button>
</form>
