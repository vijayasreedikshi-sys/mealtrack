@model CheckInPageVm
@{
    ViewData["Title"] = "Meal Check-in";
}
@section PageSub {Check in when you collect your food · @Fmt.Date(DateTime.Today, "dddd, dd MMM")}
<div class="row g-4">
  <div class="col-lg-5">
    <div class="card h-100">
      <div class="card-header"><h2>@Ui.Icon("scan-qr-code") How to check in</h2></div>
      <div class="card-body">
        <ol class="mb-4 ps-3">
          <li class="mb-2">At the counter, open your phone <strong>camera</strong> and point it at the QR on the screen.</li>
          <li class="mb-2">Tap the link that appears. Your meal is marked as eaten straight away.</li>
          <li>No camera? Type the <strong>6-digit code</strong> shown under the QR here:</li>
        </ol>
        <form method="post" action="/check-in" asp-antiforgery="true" autocomplete="off">
          <label class="form-label" for="code">Code on the screen</label>
          <div class="d-flex gap-2">
            <input class="form-control form-control-lg code-input" id="code" name="code" inputmode="numeric" pattern="[0-9 ]*" maxlength="7" placeholder="000 000" required autofocus>
            <button class="btn btn-primary btn-lg" type="submit">Check in</button>
          </div>
        </form>
      </div>
    </div>
  </div>
  <div class="col-lg-7">
    <div class="card h-100">
      <div class="card-header"><h2>@Ui.Icon("calendar-check") Today's meals</h2></div>
      @if (Model.TodayMeals.Count > 0)
      {
      <ul class="list-group list-group-flush">
        @foreach (var meal in Model.TodayMeals)
        {
          Model.Mine.TryGetValue(meal.Id, out var mine);
          var qty = mine?.Quantity ?? 0;
          <li class="list-group-item d-flex justify-content-between align-items-center py-3">
            <div>
              <div class="mb-1">@Ui.MealChip(meal.MealName)</div>
              <div class="fw-semibold">@meal.FoodName</div>
              <div class="small text-muted">@(qty > 0 ? $"You applied for {qty}" : "You did not apply")</div>
            </div>
            <div class="text-end">
              @if (mine?.CheckedInAt is { } at)
              {
                <span class="status status-completed">Checked in</span><div class="small text-muted mt-1">@Fmt.Time(at)</div>
              }
              else if (qty > 0)
              {
                <span class="status status-open">Not yet</span>
              }
              else
              {
                <span class="status status-pending">—</span>
              }
            </div>
          </li>
        }
      </ul>
      }
      else
      {
        @Ui.EmptyState("calendar-x", "No meals published for today")
      }
    </div>
  </div>
</div>
<div class="alert alert-info mt-4 mb-0">
  @Ui.Icon("leaf")
  <div>Checking in tells the kitchen who actually ate. If you won't eat a meal, set its count to <strong>0</strong> before the cutoff, so food is not cooked and wasted.</div>
</div>
