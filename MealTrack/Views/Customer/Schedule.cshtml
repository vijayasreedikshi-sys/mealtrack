@model ScheduleWeekVm
@{
    ViewData["Title"] = "Weekly Schedule";
    ViewData["PageTitle"] = "Weekly Food Schedule";
    var today = DateTime.Today;
}
@section PageSub {@Fmt.Date(Model.WeekStart, "dd MMM") – @Fmt.Date(Model.WeekEnd, "dd MMM yyyy")}
<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
  <div class="btn-group">
    <a class="btn btn-outline-secondary btn-sm" href="/customer/schedule?week=@Fmt.IsoDate(Model.PrevWeek)">@Ui.Icon("chevron-left") Previous</a>
    <a class="btn btn-outline-secondary btn-sm" href="/customer/schedule">This week</a>
    <a class="btn btn-outline-secondary btn-sm" href="/customer/schedule?week=@Fmt.IsoDate(Model.NextWeek)">Next @Ui.Icon("chevron-right")</a>
  </div>
  <a class="btn btn-primary btn-sm" href="/customer/submit?view=week&date=@Fmt.IsoDate(Model.WeekStart)">@Ui.Icon("clipboard-pen-line") Submit counts for this week</a>
</div>

<div class="card table-card">
  <div class="table-responsive">
    <table class="table week-grid">
      <thead>
        <tr>
          <th>Date</th>
          @foreach (var m in Model.MealTypes)
          {
            <th>@Ui.MealChip(m.MealName)</th>
          }
        </tr>
      </thead>
      <tbody>
        @foreach (var (day, meals) in Model.Grid)
        {
        <tr class="@(day == today ? "today-row" : "")">
          <td class="day-cell">
            <div class="fw-semibold">@Fmt.Date(day, "dddd")</div>
            <div class="small text-muted">@Fmt.Date(day, "dd MMM")@if (day == today) {<text> · <span class="text-green fw-semibold">Today</span></text>}</div>
          </td>
          @foreach (var m in Model.MealTypes)
          {
            <td class="food-cell">
              @if (meals.TryGetValue(m.MealName, out var r))
              {
                <div class="food">@r.FoodName</div>
                <div class="meta mb-1">@r.Description</div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                  @Ui.StatusBadge(r.Status)
                  @if (r.HasValue) {<span class="small fw-semibold">Qty @r.Quantity</span>}
                </div>
                @if (r.IsOpen) {<div class="meta mt-1">Cutoff @Fmt.Dt(r.CutoffTime, "ddd hh:mm tt")</div>}
              }
              else
              {
                <span class="text-muted small">Not scheduled</span>
              }
            </td>
          }
        </tr>
        }
      </tbody>
    </table>
  </div>
</div>
<p class="small text-muted mt-3 mb-0">The menu is planned by the admin. You only need to enter how many portions you want for each meal.</p>
