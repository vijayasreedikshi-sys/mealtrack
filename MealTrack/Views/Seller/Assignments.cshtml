@model AssignmentsVm
@{
    ViewData["Title"] = "Assigned Schedules";
}
@section PageSub {@Fmt.Date(Model.WeekStart, "dd MMM") – @Fmt.Date(Model.WeekStart.AddDays(13), "dd MMM yyyy") (2 weeks)}
<div class="btn-group mb-3">
  <a class="btn btn-outline-secondary btn-sm" href="/seller/assignments?week=@Fmt.IsoDate(Model.WeekStart.AddDays(-7))">@Ui.Icon("chevron-left") Previous</a>
  <a class="btn btn-outline-secondary btn-sm" href="/seller/assignments">This week</a>
  <a class="btn btn-outline-secondary btn-sm" href="/seller/assignments?week=@Fmt.IsoDate(Model.WeekStart.AddDays(7))">Next @Ui.Icon("chevron-right")</a>
</div>
<div class="card table-card">
  @if (Model.Grouped.Count > 0)
  {
  <div class="table-responsive">
    <table class="table table-hover">
      <thead><tr><th>Date</th><th>Meal</th><th>Food</th><th>Cutoff</th><th class="text-end">Required</th><th>Preparation</th><th></th></tr></thead>
      <tbody>
      @foreach (var g in Model.Grouped)
      {
        var rows = g.ToList();
        for (var i = 0; i < rows.Count; i++)
        {
          var r = rows[i];
          <tr class="@(g.Key == DateTime.Today ? "bg-green-soft" : "")">
            @if (i == 0) {<td rowspan="@rows.Count" class="fw-semibold text-nowrap">@Fmt.Date(g.Key, "ddd, dd MMM")</td>}
            <td>@Ui.MealChip(r.MealName)</td>
            <td>@r.FoodName</td>
            <td class="small text-nowrap">@Fmt.Dt(r.CutoffTime, "ddd hh:mm tt")</td>
            <td class="text-end fw-semibold">@r.TotalQty @Ui.StatusBadge(r.Final ? "final" : "open")</td>
            <td>@Ui.StatusBadge(r.PreparationStatus)</td>
            <td class="text-end">@if (r.ScheduleDate <= DateTime.Today) {<a class="btn btn-sm btn-outline-secondary" href="/seller/prep/@r.ScheduleId">Update</a>}</td>
          </tr>
        }
      }
      </tbody>
    </table>
  </div>
  }
  else
  {
    @Ui.EmptyState("calendar-x", "No published meals assigned to you in these two weeks")
  }
</div>
