@model RequirementsVm
@{
    ViewData["Title"] = "Cooking Requirements";
    ViewData["PageTitle"] = "Daily Cooking Requirements";
    var sel = Fmt.IsoDate(Model.Selected);
}
@section PageSub {@Fmt.Date(Model.Selected, "dddd, dd MMMM yyyy")}
<div class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-3 no-print">
  <form class="d-flex gap-2 align-items-center" method="get">
    <a class="btn btn-outline-secondary btn-sm btn-icon" href="/seller/requirements?date=@Fmt.IsoDate(Model.Selected.AddDays(-1))" aria-label="Previous day">@Ui.Icon("chevron-left")</a>
    <input class="form-control form-control-sm" type="date" name="date" value="@sel" onchange="this.form.submit()" style="max-width:180px">
    <a class="btn btn-outline-secondary btn-sm btn-icon" href="/seller/requirements?date=@Fmt.IsoDate(Model.Selected.AddDays(1))" aria-label="Next day">@Ui.Icon("chevron-right")</a>
  </form>
  <button class="btn btn-dark btn-sm" type="button" onclick="window.print()">@Ui.Icon("printer") Print</button>
</div>

<div class="print-only mb-3">
  <h1 class="h4 mb-0">MealTrack – Cooking requirements</h1>
  <div>@Fmt.Date(Model.Selected, "dddd, dd MMMM yyyy") · @Context.CurrentUser()!.Name · printed @Fmt.Dt(DateTime.Now)</div>
</div>

<div class="card table-card mb-4">
  <div class="card-header"><h2>@Ui.Icon("chef-hat") Meals to prepare</h2><span class="fw-bold">Grand total: <span class="text-green fs-5">@Model.Total</span></span></div>
  @if (Model.Rows.Count > 0)
  {
  <div class="table-responsive">
    <table class="table mb-0">
      <thead><tr><th>Meal</th><th>Food</th><th>Count</th><th class="text-end">Customers</th><th class="text-end">Required</th><th class="text-end">Prepared</th></tr></thead>
      <tbody>
      @foreach (var r in Model.Rows)
      {
        <tr>
          <td>@Ui.MealChip(r.MealName)</td>
          <td class="fw-semibold">@r.FoodName <span class="small text-muted">(@r.Unit)</span></td>
          <td>@Ui.StatusBadge(r.Final ? "final" : "open") @if (!r.Final) {<span class="small text-muted">until @Fmt.Time(r.CutoffTime)</span>}</td>
          <td class="text-end">@r.Submitters</td>
          <td class="text-end fw-bold fs-5">@r.TotalQty</td>
          <td class="text-end">@(r.PreparedQuantity?.ToString() ?? "—")</td>
        </tr>
      }
      </tbody>
      <tfoot><tr><td colspan="4">Grand total</td><td class="text-end text-green fs-5">@Model.Total</td><td></td></tr></tfoot>
    </table>
  </div>
  }
  else
  {
    @Ui.EmptyState("calendar-x", "No meals assigned to you on this date")
  }
</div>

@foreach (var r in Model.Rows.Where(r => r.CanViewCustomers))
{
  var list = Model.Breakdown.GetValueOrDefault(r.ScheduleId) ?? [];
  <div class="card table-card mb-4">
    <div class="card-header"><h2>@Ui.Icon("users") @r.MealName · customer-wise</h2><span class="small text-muted">@list.Count customers · @r.TotalQty portions</span></div>
    @if (list.Count > 0)
    {
    <div class="table-responsive">
      <table class="table table-sm mb-0">
        <thead><tr><th>Room</th><th>Customer</th><th class="text-end">Qty</th></tr></thead>
        <tbody>
        @foreach (var c in list.Where(c => c.Quantity > 0)) {<tr><td>@(c.RoomNo ?? "—")</td><td>@c.Name</td><td class="text-end fw-semibold">@c.Quantity</td></tr>}
        </tbody>
      </table>
    </div>
    <div class="card-body small text-muted py-2">@list.Count(c => c.Quantity == 0) customer(s) submitted 0 (not needed).</div>
    }
    else
    {
      @Ui.EmptyState("clipboard-list", "No counts submitted yet")
    }
  </div>
}
@if (Model.Rows.Count > 0 && !Model.Rows.Any(r => r.CanViewCustomers))
{
  <p class="small text-muted no-print">Customer-wise details are only shown for meals where the admin has allowed it.</p>
}
