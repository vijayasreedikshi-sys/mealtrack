@inject MealTrack.Services.NotificationService Notifications
@{
    var user = Context.CurrentUser()!;
    var unread = await Notifications.UnreadCountAsync(user.Id);
    var recent = await Notifications.RecentAsync(user.Id, 5);
    ViewData["UnreadCount"] = unread;
}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@(ViewData["Title"] ?? "Dashboard") · MealTrack</title>
  <link rel="icon" type="image/svg+xml" href="~/img/logo.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="~/css/theme.css" rel="stylesheet" asp-append-version="true">
</head>
<body>
<div class="app-shell">
  <partial name="_Sidebar" />

  <div class="app-main">
    <header class="topbar">
      <button class="icon-btn d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-label="Open menu">@Ui.Icon("menu")</button>
      <div class="min-w-0">
        <h1 class="page-title text-truncate">@(ViewData["PageTitle"] ?? ViewData["Title"] ?? "Dashboard")</h1>
        <div class="page-sub d-none d-sm-block">
          @if (IsSectionDefined("PageSub")) { @await RenderSectionAsync("PageSub") }
          else { @Fmt.Date(DateTime.Today, "dddd, dd MMMM yyyy") }
        </div>
      </div>
      <div class="topbar-actions">
        @await RenderSectionAsync("TopbarActions", required: false)
        <div class="dropdown">
          <button class="icon-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Notifications">
            @Ui.Icon("bell")@if (unread > 0) {<span class="dot">@(unread < 100 ? unread.ToString() : "99+")</span>}
          </button>
          <div class="dropdown-menu dropdown-menu-end notif-menu">
            <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
              <span class="fw-semibold">Notifications</span>
              @if (unread > 0)
              {
                <form method="post" action="/notifications/read-all" asp-antiforgery="true">
                  <input type="hidden" name="next" value="@(Context.Request.Path + Context.Request.QueryString)">
                  <button class="btn btn-link btn-sm p-0 text-green text-decoration-none" type="submit">Mark all read</button>
                </form>
              }
            </div>
            @foreach (var n in recent)
            {
              <form method="post" action="/notifications/@n.Id/open" asp-antiforgery="true">
                <button type="submit" class="notif-item @(n.IsRead ? "" : "unread")">
                  <div>@n.Message</div><div class="time">@Fmt.Ago(n.CreatedAt)</div>
                </button>
              </form>
            }
            @if (recent.Count == 0)
            {
              <div class="px-3 py-4 text-center text-muted small">You're all caught up.</div>
            }
            <a class="d-block text-center py-2 small fw-semibold text-decoration-none" href="/notifications">View all</a>
          </div>
        </div>
        <div class="dropdown d-none d-sm-block">
          <button class="avatar light border-0" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Account menu">@user.Initial</button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li class="px-3 py-2 border-bottom">
              <div class="fw-semibold small">@user.Name</div>
              <div class="text-muted small text-capitalize">@user.Role</div>
            </li>
            <li><a class="dropdown-item d-flex align-items-center gap-2" href="/profile">@Ui.Icon("user-round") Profile</a></li>
            <li>
              <form method="post" action="/logout" asp-antiforgery="true">
                <button class="dropdown-item d-flex align-items-center gap-2" type="submit">@Ui.Icon("log-out") Log out</button>
              </form>
            </li>
          </ul>
        </div>
      </div>
    </header>

    <main class="page-content">
      <partial name="_Flash" />
      @RenderBody()
    </main>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://unpkg.com/lucide@0.454.0/dist/umd/lucide.min.js"></script>
<script src="~/js/app.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
